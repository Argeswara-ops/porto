---
// src/components/Cards/ContentCard.astro — content-aware card (see ./README.md).
//
// The Figma "Article - Post Card" / "Project Card" (nodes 5:39, 14:41): one pixel-bordered card with
// a thumbnail (black bottom divider), a retro category badge, a Press Start 2P title, a clamped
// excerpt, optional tag pills (projects), and a "READ →" / "VIEW →" link. Posts and projects share
// this shell; only the badge tone, the optional tags, and the CTA word differ.
//
// Not built on ui/card: that primitive is a <div> with a 1px border + part padding model, whereas
// this needs <a>/<article> semantics and the pixel structure (4px frame, `shadow-pixel`, a 4px inner
// divider under the thumbnail). It reuses the same surface tokens ui/card would apply, plus the
// ui/badge `pixel` variant and the stroke `Icon`. Tokens only, so the light theme flips for free.
//
// ponytail: plain <img> on the Vite-fingerprinted import (like Header.astro's avatar), NOT
// astro:assets <Image>, so the build needs no Sharp. Demo thumbnails ship at ~2× display size.
import { Icon } from "@components/svg/icons";
import { Badge, type BadgeVariant } from "@components/ui/badge";

interface Props {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  badgeLabel: string;
  /** Category tone from the ui/badge palette. */
  badgeVariant?: BadgeVariant;
  /** Colour override for tones with no semantic token (LORE = fixed maroon). */
  badgeClass?: string;
  title: string;
  description: string;
  /** Project tech tags; omit for posts. */
  tags?: readonly string[];
  /** Link verb — "Read" for posts, "View" for projects. */
  cta?: string;
}
const {
  href,
  image,
  imageAlt,
  badgeLabel,
  badgeVariant = "primary",
  badgeClass,
  title,
  description,
  tags,
  cta = "Read",
} = Astro.props as Props;
---

<a
  href={href}
  class="primary-focus group hover:shadow-pixel-lg motion-reduce:transition-none block h-full transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
>
  <article
    class="bg-card text-card-foreground border-border shadow-pixel flex h-full flex-col border-4 p-1"
  >
    <!-- Thumbnail: sits on the accent tile with a 4px black divider under it (Figma "Background+HorizontalBorder"). -->
    <div class="bg-accent border-border h-40 overflow-clip border-b-4 sm:h-44">
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <div class="flex flex-1 flex-col gap-3 p-4">
      <div>
        <Badge pixel variant={badgeVariant} class={badgeClass}>{badgeLabel}</Badge>
      </div>

      <h3 class="h3 text-card-foreground text-balance">{title}</h3>

      <p class="text-muted-foreground line-clamp-3 text-sm">{description}</p>

      {
        tags && tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="bg-accent text-accent-foreground border-border border-2 px-2 py-0.5 text-xs font-bold uppercase">
                {tag}
              </li>
            ))}
          </ul>
        )
      }

      <span
        class="text-info group-hover:text-success mt-auto inline-flex items-center gap-2 pt-1 text-sm font-bold uppercase"
      >
        {cta}
        <Icon
          name="arrow-right"
          class="motion-reduce:transition-none size-4 transition-transform group-hover:translate-x-1"
        />
      </span>
    </div>
  </article>
</a>
