---
// src/components/Sections/Project/ProjectsHero.astro — Figma "Hero Panel" on the Project Log
// overview (node 72:24). The page-level intro panel: a MISSION ARCHIVE tag, the PROJECT LOG H1, and
// a one-line archive blurb. Static page copy (not per-entry), so it takes no props. Above the fold →
// no <Reveal>. Reuses the shared PixelPanel surface + the ui/badge pixel variant; tokens only.
import { Badge } from "@components/ui/badge";

import PixelPanel from "./PixelPanel.astro";
---

<PixelPanel as="section" elevated aria-labelledby="projects-hero-heading" class="p-6 sm:p-8 md:p-9">
  <div class="flex flex-col items-start gap-4">
    <Badge pixel variant="info">Mission Archive</Badge>

    <h1 id="projects-hero-heading" class="h1 text-info text-balance">Project Log</h1>

    <p class="text-muted-foreground max-w-3xl text-base text-balance">
      Quest archive — all developer operations, full-stack pipelines, and vintage terminal
      prototypes thoroughly cataloged and documented. Press view to inspect the source modules.
    </p>
  </div>
</PixelPanel>
