---
// src/components/Sections/Project/PixelPanel.astro
//
// The bare pixel surface — `bg-card` + a 4px black frame + the hard offset shadow — that the Figma
// project pages stamp out repeatedly (the hero panel and the five detail cards on node 72:191). Just
// the surface: the call site adds its own padding/layout via `class`. `elevated` swaps the larger
// hero shadow (`shadow-pixel-lg`) for the card one. Tokens only, so the light theme flips for free.
//
// Extracted because the surface recurs 6× on the detail page alone (tailwind.md: "same class cluster
// 3+ times → a component"). It intentionally does NOT touch the existing home/about hero panels,
// which inline the same cluster — those stay as-is; a later pass can migrate them onto this.
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> &
  VariantProps<typeof pixelPanel> & {
    /** Render element — a card is a `<div>`, but a hero may want a `<section>` wrapper etc. */
    as?: keyof HTMLElementTagNameMap;
  };

const pixelPanel = tv({
  base: "bg-card text-card-foreground border-border border-4",
  variants: {
    elevated: { true: "shadow-pixel-lg", false: "shadow-pixel" },
  },
  defaultVariants: { elevated: false },
});

const { as, elevated, class: className, ...rest } = Astro.props;
const Tag = as ?? "div";
---

<Tag class={pixelPanel({ elevated, class: className })} data-slot="pixel-panel" {...rest}>
  <slot />
</Tag>
