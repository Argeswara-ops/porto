---
// src/components/Sections/About/SkillTree.astro — Figma "Skill Tree Section" (node 5:331).
//
// Section heading + three centred "skill cards" (tag + icon + name). Distinct from the home
// TechStack's inline PixelChips: these are larger vertical cards, so the layout is reproduced here
// (used once → an inline map, not a new component). Below the fold → <Reveal>. Tokens only.
//
// The tag is the mock's inverted pixel tag (black surface + a coloured frame/label), so it doesn't
// map to the ui/badge `pixel` variant (tone bg + dark ink) — it's a small whole-class tone map here.
// CONTENT: retro flavour (typed local); icons reuse the same stroke `svg/icons` glyphs the home
// TechStack picked (React→component, JS→code, Python→flash), so the two pages can't drift.
import SectionHeading from "@components/Sections/Home/SectionHeading.astro";
import { Icon, type IconName } from "@components/svg/icons";
import { Reveal } from "@components/ui/reveal";

type Tone = "success" | "secondary" | "info";
const skills: readonly { name: string; icon: IconName; tone: Tone }[] = [
  { name: "JavaScript", icon: "code-01", tone: "success" },
  { name: "Python", icon: "flash-on", tone: "secondary" },
  { name: "React", icon: "component", tone: "info" },
];

// Whole static classes per tone (never interpolate a class name — invisible to the compiler).
const tagClass: Record<Tone, string> = {
  success: "border-success text-success",
  secondary: "border-secondary text-secondary",
  info: "border-info text-info",
};
const iconClass: Record<Tone, string> = {
  success: "text-success",
  secondary: "text-secondary",
  info: "text-info",
};
---

<Reveal as="section" aria-labelledby="skill-tree-heading" class="flex flex-col gap-6">
  <SectionHeading id="skill-tree-heading" title="Tech Stack" />

  <ul class="grid gap-6 sm:grid-cols-3">
    {
      skills.map((skill) => (
        <li class="bg-card text-card-foreground border-border shadow-pixel flex flex-col items-center gap-3 border-4 p-4">
          <span
            class:list={[
              "bg-border border-2 px-2 py-1 text-xs font-bold uppercase",
              tagClass[skill.tone],
            ]}
          >
            {skill.name}
          </span>
          <Icon name={skill.icon} class:list={["size-8", iconClass[skill.tone]]} />
          <span class="font-display text-foreground text-center text-sm uppercase">
            {skill.name}
          </span>
        </li>
      ))
    }
  </ul>
</Reveal>
