    href: "/projects/observability-dashboard/",
    image: pixelArt,
    imageAlt: "A pixel-art sprite editor with a colour palette and canvas grid",
    badgeLabel: "[In Progress]",
    badgeVariant: "warning",
    cta: "View",
  },
  {
    title: "Deployed a headless CMS with Next.js + Vercel",
    description:
      "Built a content platform with server components, incremental static generation, and edge caching.",
    href: "/projects/headless-cms/",
    image: cssGrid,
    imageAlt: "A glowing sword rising from a pedestal in a crystal cave",
    badgeLabel: "[Complete]",
    badgeVariant: "success",
    cta: "View",
