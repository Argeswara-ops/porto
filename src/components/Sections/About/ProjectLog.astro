    href: "/projects/realtime-chat-app/",
    image: retroChat,
    imageAlt: "A pixel-art chat application interface labelled Chatting App v1.0",
    badgeLabel: "[Complete]",
    badgeVariant: "success",
    cta: "View",
  },
  {
    title: "Migrated a monolith to microservices on AWS",
