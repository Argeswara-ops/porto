---
// src/components/Sections/About/ProjectLog.astro — Figma "Quest Log Section" (node 25:61).
//
// Data-only section: the shared heading + 1/2/3-col card grid live in <CardGrid>; this file supplies
// the six project cards. Each is a ContentCard (thumbnail + status tag + Press Start title + excerpt
// + VIEW link) — the exact shell the home Featured Projects uses, reused wholesale.
//
// CONTENT: the titles/excerpts are the mock's demo copy (meaningful, typed local — no projects
// collection ships). Status → ui/badge tone: [COMPLETE] → success (green), [IN PROGRESS] → warning
// (amber). hrefs are the intended /projects/<slug>/ routes (404 until built, same nav precedent).
// ponytail: thumbnails REUSE the six shared demo images (each appears once here, once in
// Achievements) rather than the mock's per-card art — the home-page placeholder precedent, kept lean
// (no Sharp, no 12 new assets). Alts describe the actual image; swap art + copy for real projects.
import { type ContentCardProps } from "@components/Cards/ContentCard.astro";
import CardGrid from "@components/Sections/Home/CardGrid.astro";
import cssGrid from "@images/demo/post-css-grid.jpg";
import floppyDisk from "@images/demo/post-floppy-disk.jpg";
import retroDeploy from "@images/demo/post-retro-deploy.jpg";
import cliQuest from "@images/demo/project-cli-quest.png";
