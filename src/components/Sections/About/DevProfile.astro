---
// src/components/Sections/About/DevProfile.astro — Figma "Character Profile Section" (node 5:303).
//
// The About page's opening "character sheet": the DEV PROFILE heading, a pixel avatar tile, and a
// stats card of ROLE / YRS rows plus two HP-style skill bars (FRONTEND / BACKEND). First section on
// the page → above the fold, so NO <Reveal> (a scroll-timeline element already in view renders
// mid-progress). Tokens only, so the light theme flips for free.
//
// CONTENT: the role, years, and skill %s are placeholder demo (the mock's retro flavour) — a typed
// local list to swap for a real profile. Avatar is the shared demo asset (plain <img>, no Sharp).
import SectionHeading from "@components/Sections/Home/SectionHeading.astro";
import avatar from "@images/about-avatar.png";

const specs = [
  { label: "Role", value: "Full-Stack", valueClass: "text-foreground" },
  { label: "Yrs", value: "8+", valueClass: "text-success" },
] as const;

// Skill bars: label + percentage. The track is the fixed black pixel surface (bg-border), the fill
// the info blue — both read on the card in either theme (the card flips, the track stays black).
const bars = [
  { label: "Frontend", pct: 95 },
  { label: "Backend", pct: 90 },
] as const;
---

<section aria-labelledby="dev-profile-heading" class="flex flex-col gap-6">
  <SectionHeading id="dev-profile-heading" title="Dev Profile" />

  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    <div
      class="bg-accent border-border shadow-pixel size-32 shrink-0 overflow-clip border-4 sm:size-40"
    >
      <img
        src={avatar.src}
        width={avatar.width}
        height={avatar.height}
        alt="Pixel-art portrait of the site author"
        loading="eager"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <dl
      class="bg-card text-card-foreground border-border shadow-pixel flex min-w-0 flex-1 flex-col gap-4 border-4 p-5 sm:p-6"
    >
      {
        specs.map((spec) => (
          <div class="flex items-center justify-between gap-4 text-xs font-bold uppercase sm:text-sm">
            <dt class="text-info">{spec.label}:</dt>
            <dd class={spec.valueClass}>{spec.value}</dd>
          </div>
        ))
      }

      {
        bars.map((bar) => (
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between gap-4 text-xs font-bold uppercase sm:text-sm">
              <dt class="text-info">{bar.label}</dt>
              <dd class="text-info">{bar.pct}%</dd>
            </div>
            <div class="bg-border border-info flex h-4 border-2 p-0.5" aria-hidden="true">
              <div class="bg-info h-full" style={`width: ${bar.pct}%`} />
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
