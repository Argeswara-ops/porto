---
// src/components/Sections/Home/About.astro — Figma "About Me Section" (node 14:116).
//
// Section heading + a pixel avatar tile beside a bio and a LOCATION / ROLE / FAVORITE meta list.
// One desktop frame → the avatar sits above the bio on phones, beside it from sm. Below-the-fold →
// <Reveal>. The meta is a real <dl> (label→value pairs). Tokens only.
//
// CONTENT: the bio + meta are placeholder demo copy (the mock's, retro flavour). Swap the bio for a
// real author bio; the meta rows are typed local. Avatar ships as a demo asset (plain <img>, no Sharp).
import { Reveal } from "@components/ui/reveal";
import avatar from "@images/about-avatar.png";

import SectionHeading from "./SectionHeading.astro";

const meta = [
  { label: "Location", value: "The Internet" },
  { label: "Role", value: "Full Stack Dev" },
  { label: "Favorite", value: "8-Bit Chiptunes" },
] as const;
---

<Reveal as="section" aria-labelledby="about-heading" class="flex flex-col gap-6">
  <SectionHeading id="about-heading" title="About Me" />

  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    <div
      class="bg-accent border-border shadow-pixel size-32 shrink-0 overflow-clip border-4 sm:size-40"
    >
      <img
        src={avatar.src}
        width={avatar.width}
        height={avatar.height}
        alt="Pixel-art portrait of the site author, DEV_8BIT"
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <div class="flex flex-1 flex-col gap-4">
      <p class="text-muted-foreground text-base leading-relaxed">
        I'm a developer who builds things with pixels, code, and a healthy dose of nostalgia. I write
        about the tech I use, the tools I love, and the retro systems that still inspire me.
      </p>

      <dl class="flex flex-col gap-2 text-sm">
        {
          meta.map((row) => (
            <div class="flex items-center justify-between gap-4">
              <dt class="text-foreground font-bold uppercase">{row.label}</dt>
              <dd class="text-muted-foreground uppercase">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Reveal>
