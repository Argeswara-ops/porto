---
// src/components/Sections/Home/LatestPosts.astro — Figma "Latest Posts Section" (node 5:31).
//
// Data-only section: the shared heading + 1/2/3-col card grid lives in <CardGrid>. This reads the
// three most-recent posts from the `blog` collection (newest first) so the home grid and the /blog/
// listing share ONE source and every link resolves — replacing the hardcoded placeholder list that
// stood in until the blog route landed (the same rewire the Featured Projects section got).
import { getSortedPosts } from "@components/Sections/Blog/blogData";
import { toPostCard } from "@components/Sections/Blog/postCards";

import CardGrid from "./CardGrid.astro";

const posts = (await getSortedPosts()).slice(0, 3).map(toPostCard);
---

<CardGrid headingId="latest-posts-heading" title="Latest Posts" items={posts} />
