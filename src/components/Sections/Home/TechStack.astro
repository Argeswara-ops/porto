---
// src/components/Sections/Home/TechStack.astro — Figma "Tech Stack Section" (node 14:3).
//
// Section heading + a wrapping row of pixel chips (PixelChip, static — no href). The Figma grid is
// already `flex-wrap`, so it reflows to any width for free. Below-the-fold → <Reveal>.
//
// CONTENT: retro flavour tech list (typed local). Icons are mapped to the closest glyphs in the
// existing stroke `svg/icons` registry (reused, not re-drawn) — the set has no exact `layers`/`cloud`
// glyph, so React→component and AWS→globe are deliberate nearest-matches (easy to veto).
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import type { IconName } from "@components/svg/icons";
import { Reveal } from "@components/ui/reveal";

import PixelChip from "./PixelChip.astro";

const stack: readonly { label: string; icon: IconName }[] = [
  { label: "JavaScript", icon: "code-01" },
  { label: "React", icon: "component" },
  { label: "Node.js", icon: "server-01" },
  { label: "Python", icon: "flash-on" },
  { label: "Docker", icon: "package-01" },
  { label: "AWS", icon: "globe" },
  { label: "Git", icon: "git-branch-01" },
  { label: "TypeScript", icon: "type-01" },
];
---

<Reveal as="section" aria-labelledby="tech-stack-heading" class="flex flex-col gap-6">
  <SectionHeading id="tech-stack-heading" title="Tech Stack" />

  <ul class="flex flex-wrap gap-3 sm:gap-4">
    {
      stack.map((tech) => (
        <li>
          <PixelChip icon={tech.icon} label={tech.label} />
        </li>
      ))
    }
  </ul>
</Reveal>
