---
// src/components/Sections/Global/CardGrid.astro
//
// The shared "section heading + responsive ContentCard grid" shell behind Latest Posts and Featured
// Projects — identical markup, differing only by their data. Owns the ONE grid breakpoint config
// (1 → sm:2 → lg:3) so the two sections can't drift, and the <Reveal> wrapper (below-the-fold,
// auto-gated on siteSettings.useAnimations + prefers-reduced-motion). Give it a heading + the cards.
import ContentCard, { type ContentCardProps } from "@components/Cards/ContentCard.astro";
import { Reveal } from "@components/ui/reveal";

import SectionHeading from "./SectionHeading.astro";

interface Props {
  /** id shared by the heading and the section's `aria-labelledby`. */
  headingId: string;
  title: string;
  items: readonly ContentCardProps[];
}
const { headingId, title, items } = Astro.props as Props;
---

<Reveal as="section" aria-labelledby={headingId} class="flex flex-col gap-6">
  <SectionHeading id={headingId} title={title} />

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <li>
          <ContentCard {...item} />
        </li>
      ))
    }
  </ul>
</Reveal>
