---
// src/components/Sections/Blog/RelatedPosts.astro — the "More Quests" related-posts strip on the
// article page (Figma node 5:217): a SectionHeading + up to two smaller cards (thumbnail + title +
// one-line subtitle, no badge/excerpt/CTA — distinct from the full ContentCard). Reuses the shared
// SectionHeading + ui/pixel-panel surface + <Reveal> (below the fold). Renders nothing if empty.
import SectionHeading from "@components/Sections/Home/SectionHeading.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: readonly CollectionEntry<"blog">[];
}
const { posts } = Astro.props as Props;
---

{
  posts.length > 0 && (
    <Reveal as="section" aria-labelledby="more-quests-heading" class="flex flex-col gap-6">
      <SectionHeading id="more-quests-heading" title="More Quests" />

      <ul class="grid gap-6 sm:grid-cols-2">
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class="primary-focus group hover:shadow-pixel-lg block h-full transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5 motion-reduce:transition-none"
            >
              <PixelPanel as="article" class="flex h-full flex-col p-1">
                <div class="bg-accent border-border h-40 overflow-clip border-b-4">
                  <img
                    src={post.data.heroImage.src}
                    width={post.data.heroImage.width}
                    height={post.data.heroImage.height}
                    alt={post.data.heroImageAlt}
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-2 p-4">
                  <h3 class="h3 text-card-foreground group-hover:text-info text-balance transition-colors motion-reduce:transition-none">
                    {post.data.title}
                  </h3>
                  <p class="text-muted-foreground line-clamp-1 text-sm">{post.data.description}</p>
                </div>
              </PixelPanel>
            </a>
          </li>
        ))}
      </ul>
    </Reveal>
  )
}
